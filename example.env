# Server (optional, defaults to 3000)
PORT=3000

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shop
DB_USERNAME=root
DB_PASSWORD=

# JWT
# The key name below is spelled the way the code reads it (ACCESS_TOKEN_SECRETE_KEY).
ACCESS_TOKEN_SECRETE_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE=1h
REFRESH_TOKEN_SECRET=replace-with-another-long-random-string
REFRESH_TOKEN_EXPIRES_IN=7d

# Zibal payment gateway
# "zibal" is Zibal's test merchant. Use your real merchant ID in production.
MERCHANT=zibal
# Where Zibal sends the user after paying. Must be a valid http(s) URL
# and must point at GET /payment/verify of this app.
CALLBACK_URL=http://localhost:3000/payment/verify
VERIFY_URL=https://gateway.zibal.ir/v1/verify
